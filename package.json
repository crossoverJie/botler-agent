{
	"name": "botler-agent",
	"version": "1.0.0",
	"type": "module",
	"description": "Lightweight personal agent framework: receives messages from Telegram / Feishu / WeChat (iLink) and autonomously completes short tasks within the data directory, with an optional in-process scheduler, a local WebUI, and health/metrics monitoring.",
	"license": "AGPL-3.0-only",
	"engines": {
		"node": ">=20"
	},
	"files": [
		"src",
		"AGENTS.md",
		"README.md",
		"README-ZH.md",
		".env.example",
		"tsconfig.json",
		"THIRD-PARTY-LICENSES",
		"!src/**/*.test.ts"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/crossoverJie/botler-agent.git"
	},
	"homepage": "https://github.com/crossoverJie/botler-agent#readme",
	"bugs": {
		"url": "https://github.com/crossoverJie/botler-agent/issues"
	},
	"scripts": {
		"start": "tsx src/index.ts",
		"dev": "tsx src/index.ts",
		"restart": "bash scripts/botlerctl.sh restart",
		"init": "tsx src/init.ts",
		"typecheck": "tsc --noEmit",
		"cover": "c8 --all --src src --include 'src/**/*.ts' --exclude '**/*.test.ts' --exclude 'src/types/**' node --import tsx --test \"src/**/*.test.ts\"",
		"cover:lcov": "c8 --all --src src --include 'src/**/*.ts' --exclude '**/*.test.ts' --exclude 'src/types/**' --reporter=lcovonly node --import tsx --test \"src/**/*.test.ts\"",
		"test": "node --import tsx --test \"src/**/*.test.ts\"",
		"webui": "tsx src/webui/server.ts",
		"cli": "tsx src/index.ts"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^1.2.0",
		"@earendil-works/pi-ai": "^1.2.0",
		"grammy": "^1.46.0",
		"https-proxy-agent": "^9.1.0",
		"qrcode": "^1.5.4",
		"qrcode-terminal": "^0.12.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/qrcode": "^1.5.6",
		"c8": "^12.0.0",
		"tsx": "^4.23.15",
		"typescript": "^5.7.0"
	}
}
