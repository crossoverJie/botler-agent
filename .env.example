# ===== Data root (where the Agent-operated projects live; plain git repos) =====
# The app directory itself is not inside this directory, so the data directory holds no source code or secrets.
DATA_ROOT=/path/to/your/data-root

# ===== Model =====
# Option A: built-in anthropic (default)
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-4-5
# Auth: ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN

# Option B: custom OpenAI-completions / Anthropic-messages compatible gateways (self-hosted / internal, e.g. a self-hosted OpenAI-completions gateway)
# Define providers (api / baseUrl / apiKey / models) in ~/.botler-agent/providers.json (generated by `botler init`);
# `api` is "openai-completions" (default) or "anthropic-messages". Multiple providers can coexist, selected here via PI_PROVIDER / PI_MODEL.
# No framework change needed to add one.
# PI_PROVIDER=custom
# PI_MODEL=your-model-flash
# Legacy single-provider fallback (used only when providers.json is absent and PI_PROVIDER != anthropic).
# CUSTOM_BASE_URL=
# CUSTOM_API_KEY=

# ===== Channel: Telegram (Bot API long poll, simplest, preferred) =====
# Token from @BotFather; left empty to disable Telegram
TELEGRAM_BOT_TOKEN=
# On the mainland China network the Telegram API is blocked, so a proxy is required to connect; fill in your proxy (e.g. Clash default http://127.0.0.1:7890)
TG_PROXY=
# Optional comma-separated Telegram sender allowlist (user ids or usernames). Empty = allow all.
TELEGRAM_ALLOW_FROM=

# ===== Channel: Feishu (event subscription webhook) =====
# Left empty to disable Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Event subscription verification token. In v2 this is MANDATORY whenever FEISHU_APP_ID
# and FEISHU_APP_SECRET are both set: config load fails fast rather than serve an
# unauthenticated webhook. Leaving the whole Feishu block empty disables the channel.
FEISHU_VERIFICATION_TOKEN=
# encrypt key (for message encryption). If empty, only plaintext events are processed.
FEISHU_ENCRYPT_KEY=
# Feishu webhook listening port
FEISHU_PORT=3000
# Optional comma-separated Feishu allowlist (sender open_id/user_id/union_id or chat_id). Empty = allow all.
FEISHU_ALLOW_FROM=

# ===== Channel: WeChat (iLink / ClawBot official Bot API, text-only DMs) =====
# Set to 1 to enable the WeChat channel. Log in first via: botler wechat-login
# (prints a QR code in the terminal; scan it with WeChat). Credentials are saved to
# ~/.botler-agent/wechat/account.json — never commit them.
WECHAT_ENABLED=0
# Account owner id (normally resolved from account.json after login). Optional override.
# WECHAT_OWNER_ID=
# Optional: comma-separated extra ilink_user_id allowlist. The account owner (the person
# who scanned the QR) is always allowed. Leave empty = only the owner can talk to the bot.
WECHAT_ALLOW_FROM=
# WeChat session renewal reminder: when the account owner has been quiet this many hours,
# the bot proactively sends a reminder to refresh the 24h context_token window.
# 0 = disabled; 1-24 = remind after N hours (default 23). Applies to the owner only.
WECHAT_REMINDER_HOURS=23
# WeChat image batching window in seconds: a selected photo is delivered immediately while the
# user may still be typing the caption. Image messages wait up to this long for a follow-up text
# from the same sender so both are processed as one task. 0 = disable (dispatch images
# immediately). Default 60.
WECHAT_IMAGE_BATCH_SECONDS=60

# ===== git commit/push =====
# Whether to additionally git push after a write task commits (=1 to enable; default off — local commit only, push failure is a warning, not a blocker)
GIT_PUSH=0

# ===== WebUI =====
# Requires the binary to be built with `--features webui` (or webui,channels).
# Set to 1 to start the local task-log UI (binds 127.0.0.1 only; the only write action is deleting task logs)
WEBUI_ENABLED=0
# WebUI listening port (binds 127.0.0.1 only, not exposed to LAN/WAN)
WEBUI_PORT=8900
# WebUI bind host. Default 127.0.0.1 = local only; set 0.0.0.0 in Docker to reach it from the host/LAN.
# WEBUI_HOST=127.0.0.1
# Task-log storage dir (JSONL, one file per day). Default: ~/.botler-agent/task-logs/
# BOTLER_LOG_DIR=

# ===== Monitor (process health monitoring / metrics) =====
# Always-on local health endpoints (on by default): /healthz (JSON), /metrics (Prometheus text), /healthz/history (trend sampling).
# Bound to 127.0.0.1, for local daemons / scrapers only, not exposed to the LAN. The WebUI "🩺 Monitor" view reads the same data.
# Set to 0 to disable only the standalone 8899 scrape endpoint (for Prometheus / external probes); the WebUI "🩺 Monitor" view is sampled by the WebUI process itself and is unaffected. On by default.
# MONITOR_ENABLED=1
# Monitor endpoint listen port (avoid 3000=feishu, 8900=webui). Default 8899.
# MONITOR_PORT=8899

# ===== Scheduler (scheduled tasks) =====
# Set to 1 to run the in-process scheduler that fires schedules.json entries into dispatch.
SCHEDULER_ENABLED=0
# Schedule config file. Default: ~/.botler-agent/schedules.json
# BOTLER_SCHEDULES_FILE=

# China legal-holiday calendar for holidayMode:"workday" schedules.
# Default source (community-maintained; uses {year} placeholder):
# BOTLER_HOLIDAY_API_URL=https://raw.githubusercontent.com/NateScarlet/holiday-cn/master/{year}.json
# Cached holiday data file (auto-refreshed at startup + every 24h). Default ~/.botler-agent/holidays.json
# BOTLER_HOLIDAYS_FILE=

# ===== Agent tool-call turn limit =====
# Max tool-call turns allowed per task (one assistant message with >=1 toolCall counts as 1 turn).
# As the limit is approached the framework hints the model to wrap up; at the limit it hard-stops. Default 20.
# MAX_TOOL_TURNS=20

# ===== v1-only: conversation context sliding window =====
# These keys are read by the v1 `main` branch only. v2 replaced the sliding window
# with persistent per-(source, conversation_id, project) sessions plus three-tier
# memory; see README.md "Sessions" and the BOTLER_SESSION_* / BOTLER_MEMORY_* keys.
# They are kept here for `.env` compatibility during a side-by-side migration.
# CONVERSATION_CONTEXT_ENABLED=1
# CONVERSATION_CONTEXT_TURNS=5
# CONVERSATION_TURN_MAX_CHARS=4000
# CONVERSATION_CONTEXT_MAX_CHARS=12000
